# Environment template. Copy to .env for local work without Doppler.
# Source of truth for real values is Doppler: dev (local + GitHub Actions),
# stg (Vercel Preview) and prd (Vercel Production). Never commit real values.

# --- Required at runtime (validated on server start by lib/serverEnvironment.ts) ---

# Postgres — pooled connection used by the app (postgres:// or postgresql://)
DATABASE_URL_POOLED="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require&channel_binding=require"

# Neon Auth — sign-in for your app (cookie secret: at least 32 bytes)
NEON_AUTH_BASE_URL="https://[endpoint].neonauth.[region].aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="[cookie_secret_at_least_32_bytes]"

# Encryption key for saved invoice and party data — exactly 64 hex characters (generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))")
# Losing or changing it makes previously saved data unreadable.
INVOICE_DATA_ENCRYPTION_KEY="[64_hex_characters]"

# Vercel Cron — random secret, at least 16 bytes
CRON_SECRET="[random_secret_at_least_16_characters]"

# Dependency health endpoint — separate Bearer secret, at least 32 bytes
HEALTH_CHECK_SECRET="[random_secret_at_least_32_characters]"

# --- Required by Prisma CLI (migrations, prisma generate, typecheck, backup) ---

# Postgres — direct connection, without pooling
DATABASE_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require&channel_binding=require"

# --- Optional ---

# Site URL — canonical address and links in emails
# (NEXT_PUBLIC_SITE_URL takes precedence; default http://localhost:3000)
SITE_URL="[your_site_url]"
NEXT_PUBLIC_SITE_URL="[your_site_url]"

# Service provider details rendered in legal documents
SERVICE_PROVIDER_NAME="[service_provider_full_name]"
SERVICE_PROVIDER_ADDRESS="[service_provider_correspondence_address]"

# Success heartbeat sent only after all retention operations complete
RETENTION_HEARTBEAT_URL="https://[monitoring_provider]/[private_heartbeat_token]"

# Rate limiting — Upstash Redis (without it limits are not enforced)
UPSTASH_REDIS_REST_URL="https://[endpoint].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[token]"

# Resend — emails and health check probe (without the key sending is skipped)
RESEND_API_KEY="[resend_api_key]"

# Contact form emails (defaults are used when unset)
CONTACT_FROM_EMAIL="Invoice Creator <kontakt@mail.[your_domain]>"
CONTACT_NOTIFY_EMAIL="[your_notification_email]"
CONTACT_REPLY_TO="kontakt@mail.[your_domain]"

# Sentry — error reporting on server/Edge and in the browser
SENTRY_DSN="[sentry_dsn]"
NEXT_PUBLIC_SENTRY_DSN="[sentry_dsn]"

# Sentry — build only, uploads source maps
SENTRY_AUTH_TOKEN="[sentry_auth_token]"

# --- Reserved / backup (not read by the app) ---

# Resend email verification flag
RESEND_VERIFICATION_EMAIL=true

# Backup Resend SMTP key
RESEND_SMTP_API_KEY="[resend_smtp_api_key]"

# S3-compatible object storage — reserved for future file storage
AWS_ENDPOINT_URL_S3="https://[endpoint].storage.[region].aws.neon.tech"
AWS_ACCESS_KEY_ID="[access_key_id]"
AWS_SECRET_ACCESS_KEY="[secret_access_key]"
AWS_REGION="[region]"
S3_BUCKET="[bucket_name]"
