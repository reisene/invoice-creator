# Auto-normalize line endings to LF on commit
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf

# Binary files should not be modified
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
