generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TaxParam {
  id                     Int      @id @default(autoincrement())
  year                   Int      @unique
  pensionRate            Decimal  @default(0.0976) @db.Decimal(5, 4)
  rentRate               Decimal  @default(0.015) @db.Decimal(5, 4)
  sicknessRate           Decimal  @default(0.0245) @db.Decimal(5, 4)
  healthRate             Decimal  @default(0.09) @db.Decimal(5, 4)
  taxRate1               Decimal  @default(0.12) @db.Decimal(5, 4)
  taxRate2               Decimal  @default(0.32) @db.Decimal(5, 4)
  taxThreshold           Decimal  @default(120000) @db.Decimal(12, 2)
  monthlyTaxReduction    Decimal  @default(300) @db.Decimal(10, 2)
  yearlyYoungReliefLimit Decimal  @default(85528) @db.Decimal(12, 2)
  zusLimitMultiple       Int      @default(30)
  minimumWage            Decimal  @default(4300) @db.Decimal(10, 2)
  costRateStandard       Decimal  @default(0.2) @db.Decimal(5, 4)
  costRateArtistic       Decimal  @default(0.5) @db.Decimal(5, 4)
  createdAt              DateTime @default(now())
  createdBy              String
  comment                String?

  @@index([year])
}

enum PartyKind {
  CLIENT
  CONTRACTOR
}

enum TermsAcceptanceMethod {
  EMAIL_PASSWORD
  MAGIC_LINK
  ACCOUNT_RECONSENT
}

enum CookieConsentChoice {
  ACCEPT_OPTIONAL
  REJECT_OPTIONAL
  ACCEPT_ANALYTICS
  ACCEPT_REPLAY
}

model Invoice {
  id             String   @id @default(cuid())
  userId         String
  uid            String?
  invoiceNumber  String?
  title          String
  contractNumber String?
  issuePlace     String?
  issueDate      String?
  periodStart    String
  net            Decimal  @db.Decimal(12, 2)
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, invoiceNumber])
  @@unique([userId, uid])
  @@index([userId, updatedAt])
}

model InvoiceSequence {
  id    Int    @id @default(autoincrement())
  scope String
  year  Int
  value Int    @default(0)

  @@unique([scope, year])
}

model SavedParty {
  id         String    @id @default(cuid())
  userId     String
  kind       PartyKind
  label      String
  clientType String?
  name       String
  address    String
  nip        String?
  pesel      String?
  createdAt  DateTime  @default(now())

  @@index([userId, kind])
}

model UserBankAccount {
  id            String @id @default(cuid())
  userId        String @unique
  accountHolder String
  bankName      String
  accountNumber String
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model TermsAcceptance {
  id                           String                @id @default(cuid())
  userId                       String?
  email                        String
  termsVersion                 String
  registrationMethod           TermsAcceptanceMethod
  acceptedAt                   DateTime              @default(now()) @db.Timestamptz(3)
  earlyServiceStartRequested   Boolean               @default(false)
  earlyServiceStartRequestedAt DateTime?             @db.Timestamptz(3)
  retainedForDispute           Boolean               @default(false)
  disputeReference             String?
  accountDeletionRequestedAt   DateTime?             @db.Timestamptz(3)

  @@unique([userId, termsVersion])
  @@index([email, termsVersion, registrationMethod, userId, acceptedAt])
}

model CookieConsent {
  id             String              @id @default(cuid())
  userId         String?
  consentVersion String
  choice         CookieConsentChoice
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}
